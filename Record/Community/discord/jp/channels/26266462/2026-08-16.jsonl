{"id": "1538445658862649415", "channel_id": "1400058619726266462", "author_id": "1421799819877290054", "author_name": "yamaiame_ql4", "content": "狂魔染めやるならキーチャ死んでるのでカフリンクスあたり取るのおすすめ", "timestamp": "2026-08-16T07:13:48.011000+00:00", "type": 19, "mentions": ["387235373845315585"], "reactions": [{"emoji": "👍", "emoji_id": null, "count": 1}], "reply_to": "1538426307623256135"}
