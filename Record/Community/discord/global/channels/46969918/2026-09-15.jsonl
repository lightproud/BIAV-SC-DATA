{"id": "1549263342781202453", "channel_id": "1300659580446969918", "author_id": "1474823004478505020", "author_name": "dimas677_", "content": "А ну да, типо собачка", "timestamp": "2026-09-15T03:39:24.840000+00:00", "type": 19, "mentions": ["359687082421256204"], "reply_to": "1549263100933312603"}
