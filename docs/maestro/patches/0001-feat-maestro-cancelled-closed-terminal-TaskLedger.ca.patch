+
+describe('cancelSession — from retrying (acceptance 2)', () => {
+  it('drops the scheduled retry: due time passes and nothing runs again', async () => {
+    const clock = testClock(1_000);
+    const store = memoryStore();
+    const ledger = new TaskLedger({
+      store,
+      clock,
